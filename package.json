{
  "name": "nobrecor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:thin-content": "node scripts/check-thin-content.mjs",
    "check:rotas": "node scripts/check-rotas.mjs",
    "ci": "npm run lint && npm run type-check && npm test && npm run check:rotas && npm run build",
    "indexnow": "node scripts/ping-indexnow.mjs",
    "postbuild": "node scripts/ping-indexnow.mjs || true",
    "prepare": "husky",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
